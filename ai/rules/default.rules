prefix_rule(pattern=["git"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "gh pr create --title \"Add repository guidelines\" --body \"## Summary\n- add AGENTS.md contributor guide\n\n## Testing\n- not run (docs only)\""], decision="allow")
prefix_rule(pattern=["npx", "react-native", "init", "StickyGoalHost", "--directory", "host-app"], decision="allow")
prefix_rule(pattern=["mkdir", "-p", "/Users/user/dotfiles/ai/skills"], decision="allow")
prefix_rule(pattern=["readlink", "~/.codex/skills"], decision="allow")
